{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "innernet",
  "version": "2.0.0",
  "identifier": "no.tonari.innernet.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "innernet",
        "width": 440,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Network",
    "shortDescription": "innernet desktop client",
    "longDescription": "Desktop client and system tray interface for innernet networks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": ["glibc", "webkit2gtk4.1"]
      }
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>no.tonari.innernetd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/innernet-daemon</string>
        <string>--socket-path</string>
        <string>/var/run/innernet/innernetd.sock</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/innernetd.log</string>
    <key>StandardOutPath</key>
    <string>/var/log/innernetd.log</string>
</dict>
</plist>
